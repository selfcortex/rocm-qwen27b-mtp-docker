# Copy to .env and fill in. .env is gitignored - never commit real values.

# IP of the LAN interface to bind published ports to (Grafana + llama API).
# Use the machine's LAN address, e.g. from: ip -br a  (must be a real IP on the host)
LAN_IP=192.168.1.2

# Grafana admin credentials (change the password before first start)
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me

# Host group IDs for GPU access (check with: getent group video render)
VIDEO_GID=983
RENDER_GID=987

# Absolute host paths to the model files (see README "Model" section).
MODEL_FILE=/path/to/Qwen3.8-27B-UD-IQ4_XS.gguf
MMPROJ_FILE=/path/to/mmproj-model-bf16.gguf

# Host directory for the KV snapshot (mounted as /cache in the llama container).
# run.sh restores the conversation from here at start and re-saves it while idle.
LLAMA_CACHE_DIR=/mnt/AI/cache

# Optional: gfx version override for ROCm (default 10.3.0 = RX 6800 XT, gfx1030).
# Uncomment and adjust only if your GPU differs.
# HSA_OVERRIDE_GFX_VERSION=10.3.0
