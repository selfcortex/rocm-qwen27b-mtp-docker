# Copy to .env and fill in. .env is gitignored - never commit real values.

# IP of the LAN interface to bind published ports to (Grafana).
# Use the machine's LAN address, e.g. from: ip -br a
LAN_IP=192.168.1.215

# Grafana admin credentials (change the password before first start)
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me

# Host group IDs for GPU access (check with: getent group video render)
VIDEO_GID=983
RENDER_GID=987

# Optional: gfx version override for ROCm (default 10.3.0 = RX 6800 XT, gfx1030).
# Uncomment and adjust only if your GPU differs.
# HSA_OVERRIDE_GFX_VERSION=10.3.0
